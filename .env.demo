# Copy this file to `.env` and fill in your own credentials.
#   cp .env.demo .env

# Question so we don't have to keep typing it
QUESTION="What is the RemindMe Application"

# Monthly token budget -- used to ensure we don't go above
OPENAI_MONTHLY_TOKEN_BUDGET=10000000

# Pinecone — vector store for the RAG index
PINECONE_API_KEY=

# Name of your Pinecone index (512-dim vectors, cosine similarity)
PINECONE_INDEX_NAME=huetter

# Log Level
LOG_LEVEL=info

LOGGER_NAME=agentic-ai-training

LOGGER_FILE=/var/tmp/agentic-ai-training.log

# Admin Key READ ONLY -- Used for getting token usage
OPENAI_ADMIN_KEY=

# Separate OpenAI chat and embedding settings
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat Model
OPENAI_MODEL=gpt-4.1-mini

# OpenAI — For general purpose / chat
OPENAI_API_KEY=

# OpenAPI Embedding BASE URL
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1

# OpenAI — used for embeddings (text-embedding-3-small) and chat (gpt-4.1-mini)
OPENAI_EMBEDDING_API_KEY=

# OpenAI Embedding Model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
