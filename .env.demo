# Copy to .env and fill in credentials: cp .env.demo .env
# Never commit live secrets. Blank credentials are intentional; samples are placeholders.
# Optional settings are commented out to preserve automatic defaults and prompting.
# Precedence for bin commands: environment, selected config file, explicit CLI options.

# Configuration and logging
# Select a different config file; sample: /absolute/path/local.env.
# AGENTICAI_CONFIG=/absolute/path/local.env
# Disable dotenv loading for isolated tests; sample: false.
PYTHON_DOTENV_DISABLED=false
# Log verbosity; sample: INFO (DEBUG enables detailed activity).
LOG_LEVEL=INFO
# Optional log file relative to the working directory; sample: logs/agenticai.log.
LOGGER_FILE=logs/agenticai.log
# Enable CLI debug logging; sample: false.
P3_DEBUG=false

# OpenAI chat, embeddings, and account reporting
# Shared chat/embedding credential; sample: sk-your-api-key.
OPENAI_API_KEY=
# OpenAI endpoint for chat, conversation, admin and comparison clients.
# Sample: https://api.openai.com/v1.
OPENAI_BASE_URL=https://api.openai.com/v1
# Terminal chat/conversation and comparison model; sample: gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Support RAG/test-question generation model; sample: gpt-4.1-mini.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Embedding model for ingestion and retrieval; sample: text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vector length; must match the Pinecone index; sample: 512.
OPENAI_EMBEDDING_DIMENSIONS=512
# Organization usage/cost-report credential; sample: sk-admin-your-key.
OPENAI_ADMIN_KEY=
# Optional monthly USD limit for reporting, not spending enforcement; sample: 100.00.
# OPENAI_MONTHLY_BILL_LIMIT_USD=100.00
# Monthly token budget for reporting, not request enforcement; sample: 10000000.
OPENAI_MONTHLY_TOKEN_BUDGET=10000000

# Support RAG and Pinecone
# Index ingestion/query credential; sample: pcsk-your-api-key.
PINECONE_API_KEY=
# Existing Pinecone index name; sample: remindme.
PINECONE_INDEX_NAME=remindme
# Legacy fallback when PINECONE_INDEX_NAME is unset; sample: remindme.
# PINECONE_INDEX=remindme
# Namespace shared by ingestion/retrieval; sample: __default__.
PINECONE_NAMESPACE=__default__
# Optional default question; keep commented to preserve prompting.
# Sample: "What is the RemindMe application?"
# QUESTION="What is the RemindMe application?"

# Comparison research and memory
# Tavily web/news search credential; sample: tvly-your-api-key.
TAVILY_API_KEY=
# Hosted mem0 credential, also validated for filesystem live runs; sample: m0-your-key.
MEM0_API_KEY=
# Comparison memory backend: MEM0 or FILESYSTEM; sample: MEM0.
MEMORY_METHOD=MEM0
# Hosted-memory namespace workspace; sample: market-research.
P3_WORKSPACE=market-research
# Maximum results per Tavily search (1-10); sample: 5.
P3_SEARCH_RESULTS=5
# News publication/search window in days (1-365); sample: 30.
P3_NEWS_DAYS=30
# External request timeout in seconds (1-300); sample: 60.
P3_TIMEOUT_SECONDS=60
# Validated source-character budget (1-10000); search currently uses a fixed cap.
# Sample: 2500.
P3_SOURCE_CHARS=2500
# Maximum extraction output tokens (1-12000); sample: 3000.
P3_MAX_OUTPUT_TOKENS=3000
# Local SDK setup directory, not hosted data storage; sample: comparison_app/.runtime/mem0.
MEM0_DIR=comparison_app/.runtime/mem0
# SDK telemetry toggle; adapters force false on initialization; sample: false.
MEM0_TELEMETRY=false

# Streamlit listeners
# Comparison app port (1-65535); sample: 5555.
P3_STREAMLIT_PORT=5555
# Comparison app bind address; sample: 127.0.0.1.
P3_STREAMLIT_ADDRESS=127.0.0.1
# Support app port (1-65535); sample: 8501.
STREAMLIT_SUPPORT_APP_PORT=8501
# Support app bind address; sample: 127.0.0.1.
STREAMLIT_SUPPORT_APP_ADDRESS=127.0.0.1

# Appearance and PDF export
# Initial UI theme before sidebar selection; sample: light (or dark).
P3_DEFAULT_THEME=light
# Enable the local background image; sample: true.
P3_BACKGROUND_ENABLED=true
# Local background image path; sample: comparison_app/assets/futuristic-it-background.png.
P3_BACKGROUND_IMAGE=comparison_app/assets/futuristic-it-background.png
# Optional regular Unicode TTF; omit for bundled Vera; sample: /path/to/Regular.ttf.
# P3_PDF_FONT_PATH=/path/to/Regular.ttf
# Optional bold Unicode TTF; omit for bundled Vera Bold; sample: /path/to/Bold.ttf.
# P3_PDF_BOLD_FONT_PATH=/path/to/Bold.ttf

# Status-agent tests only
# These keys are referenced by tests/test_status_*.py. The status_agent package
# is absent in this checkout; these do not configure the current comparison apps.
# Opt into PostgreSQL integration tests with a dedicated test database.
# Sample: postgresql://test_user:test_password@localhost:5432/agenticai_test.
# PM_TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/agenticai_test
# Enable status-agent test LLM summaries; sample: false.
# PM_USE_LLM=false
# Maximum collector pages in tests; sample: 1.
# PM_MAX_PAGES=1
# Maximum summary context characters in tests; sample: 10000.
# PM_MAX_CONTEXT_CHARS=10000
# Test collector source list; sample: jira,asana.
# PM_SOURCES=jira,asana
# Test Notion property mapping; sample: {"status":"Stage"}.
# PM_NOTION_PROPERTIES='{"status":"Stage"}'
# Asana test credential; sample: your-asana-token.
# ASANA_ACCESS_TOKEN=your-asana-token
# Asana test project ID; sample: 123456789.
# ASANA_PROJECT_ID=123456789
# Jira test endpoint; sample: https://example.atlassian.net.
# JIRA_BASE_URL=https://example.atlassian.net
# Jira test account email; sample: user@example.com.
# JIRA_EMAIL=user@example.com
# Jira test credential; sample: your-jira-token.
# JIRA_API_TOKEN=your-jira-token
# Jira test board ID; sample: 1.
# JIRA_BOARD_ID=1
# Notion test credential; sample: your-notion-token.
# NOTION_API_TOKEN=your-notion-token
# Notion test data source ID; sample: your-data-source-id.
# NOTION_DATA_SOURCE_ID=your-data-source-id

# Command-specific CLI overrides
# Generated keys read by utils.cli.configuration_key/configured_value.
# All overrides are optional and commented to avoid changing command behavior.
# Uncomment to enable; explicit CLI arguments still win. Lists use JSON arrays.
# A custom --api-key-env value names a user-defined secret variable; add that
# variable to your private .env if using a name other than OPENAI_ADMIN_KEY.

# agenticai-comparison-app.py
# Enable application debug logging. Sample: false.
# AGENTICAI_COMPARISON_APP_DEBUG=false
# Streamlit listener TCP port. Sample: 5555.
# AGENTICAI_COMPARISON_APP_PORT=5555
# Streamlit bind address. Sample: 127.0.0.1.
# AGENTICAI_COMPARISON_APP_ADDRESS=127.0.0.1

# agenticai-comparison-research
# Enable application debug logging. Sample: false.
# AGENTICAI_COMPARISON_RESEARCH_DEBUG=false
# Use fictional offline services without API calls. Sample: false.
# AGENTICAI_COMPARISON_RESEARCH_DEMO=false
# Briefing output format. Sample: json.
# AGENTICAI_COMPARISON_RESEARCH_FORMAT=json
# Create a new output file instead of writing to stdout. Sample: report.json.
# AGENTICAI_COMPARISON_RESEARCH_OUTPUT=report.json
# Live memory backend (MEMORY_METHOD). Sample: MEM0.
# AGENTICAI_COMPARISON_RESEARCH_MEMORY_METHOD=MEM0
# Company namespace/input. Sample: Toyota.
# AGENTICAI_COMPARISON_RESEARCH_COMPANY=Toyota

# agenticai-generate-test-questions
# Enable application debug logging. Sample: false.
# AGENTICAI_GENERATE_TEST_QUESTIONS_DEBUG=false
# Markdown file to write. Defaults to 20Questions.md. Sample: report.json.
# AGENTICAI_GENERATE_TEST_QUESTIONS_OUTPUT=report.json
# Number of questions to generate. Sample: 20.
# AGENTICAI_GENERATE_TEST_QUESTIONS_COUNT=20
# OpenAI chat model to use. Sample: gpt-4.1-mini.
# AGENTICAI_GENERATE_TEST_QUESTIONS_MODEL=gpt-4.1-mini
# Approximate character budget for sampled source context. Sample: 18000.
# AGENTICAI_GENERATE_TEST_QUESTIONS_CONTEXT_BUDGET=18000
# Optional random seed for repeatable source sampling. Sample: 42.
# AGENTICAI_GENERATE_TEST_QUESTIONS_SEED=42

# agenticai-mem0-query
# memory-id is an alternative to listing filters: do not combine it with
# company, run-id, or kind. Enable only the lookup or listing settings you need.
# Enable application debug logging. Sample: false.
# AGENTICAI_MEM0_QUERY_DEBUG=false
# Company namespace in P3_WORKSPACE. Sample: Toyota.
# AGENTICAI_MEM0_QUERY_COMPANY=Toyota
# Restrict listing to one research run. Sample: example-run.
# AGENTICAI_MEM0_QUERY_RUN_ID=example-run
# Artifact kind, such as discovery or briefing. Sample: manual.
# AGENTICAI_MEM0_QUERY_KIND=manual
# Retrieve one memory by its mem0 ID. Sample: example-memory-id.
# AGENTICAI_MEM0_QUERY_MEMORY_ID=example-memory-id
# Hosted memory listing page. Sample: 1.
# AGENTICAI_MEM0_QUERY_PAGE=1
# Hosted memory results per page. Sample: 20.
# AGENTICAI_MEM0_QUERY_PAGE_SIZE=20

# agenticai-mem0-store
# Enable application debug logging. Sample: false.
# AGENTICAI_MEM0_STORE_DEBUG=false
# Company namespace (required). Sample: Toyota.
# AGENTICAI_MEM0_STORE_COMPANY=Toyota
# Stored memory artifact kind. Sample: manual.
# AGENTICAI_MEM0_STORE_KIND=manual
# Research run identifier for stored memory. Sample: example-run.
# AGENTICAI_MEM0_STORE_RUN_ID=example-run
# JSON input file, or - for stdin. Sample: data.json.
# AGENTICAI_MEM0_STORE_FILE=data.json

# agenticai-openai-admin
# Enable application debug logging. Sample: false.
# AGENTICAI_OPENAI_ADMIN_DEBUG=false
# List all models available to OPENAI_ADMIN_API_KEY instead of reporting usage. Sample: false.
# AGENTICAI_OPENAI_ADMIN_LIST_MODELS=false
# API key variable (default: OPENAI_API_KEY for models, OPENAI_ADMIN_KEY for usage). Sample: OPENAI_ADMIN_KEY.
# AGENTICAI_OPENAI_ADMIN_API_KEY_ENV=OPENAI_ADMIN_KEY
# Unix start time for the report. Defaults to the start of this UTC month. Sample: 1790812800.
# AGENTICAI_OPENAI_ADMIN_START_TIME=1790812800
# Unix end time for the report. Defaults to now. Sample: 1793491200.
# AGENTICAI_OPENAI_ADMIN_END_TIME=1793491200
# Optional local monthly USD bill limit. Defaults to OPENAI_MONTHLY_BILL_LIMIT_USD. Sample: 100.00.
# AGENTICAI_OPENAI_ADMIN_MONTHLY_BILL_LIMIT_USD=100.00
# Optional local monthly token budget. Defaults to OPENAI_MONTHLY_TOKEN_BUDGET. Sample: 10000000.
# AGENTICAI_OPENAI_ADMIN_MONTHLY_TOKEN_BUDGET=10000000

# agenticai-openai-chat
# Enable application debug logging. Sample: false.
# AGENTICAI_OPENAI_CHAT_DEBUG=false
# Default question. Sample: "What is the RemindMe application?".
# AGENTICAI_OPENAI_CHAT_QUESTION="What is the RemindMe application?"

# agenticai-openai-conversation
# Enable application debug logging. Sample: false.
# AGENTICAI_OPENAI_CONVERSATION_DEBUG=false

# agenticai-rag-hybrid-query
# Enable application debug logging. Sample: false.
# AGENTICAI_RAG_HYBRID_QUERY_DEBUG=false
# Question to send to chat. Sample: "What is the RemindMe application?".
# AGENTICAI_RAG_HYBRID_QUERY_QUESTION="What is the RemindMe application?"
# Pinecone index name. Defaults to PINECONE_INDEX_NAME or PINECONE_INDEX. Sample: remindme.
# AGENTICAI_RAG_HYBRID_QUERY_INDEX=remindme
# Pinecone namespace to query. Sample: __default__.
# AGENTICAI_RAG_HYBRID_QUERY_NAMESPACE=__default__
# OpenAI chat model. Sample: gpt-4.1-mini.
# AGENTICAI_RAG_HYBRID_QUERY_CHAT_MODEL=gpt-4.1-mini
# OpenAI embedding model. Sample: text-embedding-3-small.
# AGENTICAI_RAG_HYBRID_QUERY_EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimensions to request from OpenAI. Sample: 512.
# AGENTICAI_RAG_HYBRID_QUERY_EMBEDDING_DIMENSIONS=512
# Final retrieved result count. Sample: 6.
# AGENTICAI_RAG_HYBRID_QUERY_TOP_K=6
# Vector retriever candidate count. Sample: 12.
# AGENTICAI_RAG_HYBRID_QUERY_VECTOR_TOP_K=12
# BM25 candidate count. Sample: 12.
# AGENTICAI_RAG_HYBRID_QUERY_BM25_TOP_K=12
# Vector contribution to ensemble ranking. Sample: 0.65.
# AGENTICAI_RAG_HYBRID_QUERY_VECTOR_WEIGHT=0.65
# BM25 contribution to ensemble ranking. Sample: 0.35.
# AGENTICAI_RAG_HYBRID_QUERY_BM25_WEIGHT=0.35
# Minimum ensemble score required before asking OpenAI for an answer. Sample: 0.2.
# AGENTICAI_RAG_HYBRID_QUERY_CONFIDENCE_THRESHOLD=0.2
# Filter by exact source path. Can be repeated. Sample: '[]'.
# AGENTICAI_RAG_HYBRID_QUERY_SOURCE='[]'
# Filter by exact source filename. Can be repeated. Sample: '[]'.
# AGENTICAI_RAG_HYBRID_QUERY_SOURCE_NAME='[]'
# Filter by exact source directory name. Can be repeated. Sample: '[]'.
# AGENTICAI_RAG_HYBRID_QUERY_SOURCE_DIR='[]'
# Additional exact metadata filter. Can be repeated. Sample: '[]'.
# AGENTICAI_RAG_HYBRID_QUERY_METADATA='[]'
# Log source details after the answer. Sample: false.
# AGENTICAI_RAG_HYBRID_QUERY_SHOW_SOURCES=false

# agenticai-support-app.py
# Enable application debug logging. Sample: false.
# AGENTICAI_SUPPORT_APP_DEBUG=false
# Streamlit listener TCP port. Sample: 8501.
# AGENTICAI_SUPPORT_APP_PORT=8501
# Streamlit bind address. Sample: 127.0.0.1.
# AGENTICAI_SUPPORT_APP_ADDRESS=127.0.0.1

# agenticai-vectordb-query
# Enable application debug logging. Sample: false.
# AGENTICAI_VECTORDB_QUERY_DEBUG=false
# Pinecone index name. Defaults to PINECONE_INDEX_NAME or PINECONE_INDEX. Sample: remindme.
# AGENTICAI_VECTORDB_QUERY_INDEX=remindme
# Pinecone namespace to inspect. Sample: __default__.
# AGENTICAI_VECTORDB_QUERY_NAMESPACE=__default__
# Inspect every namespace reported by Pinecone index stats. Sample: false.
# AGENTICAI_VECTORDB_QUERY_ALL_NAMESPACES=false
# Number of vector IDs to fetch at a time. Sample: 100.
# AGENTICAI_VECTORDB_QUERY_BATCH_SIZE=100
# Print vector IDs and chunk indexes under each source file. Sample: false.
# AGENTICAI_VECTORDB_QUERY_SHOW_CHUNKS=false

# agenticai-vectordb-upsert
# Enable application debug logging. Sample: false.
# AGENTICAI_VECTORDB_UPSERT_DEBUG=false
# Directory glob to scan. Defaults to RemindMe*. Sample: RemindMe*.
# AGENTICAI_VECTORDB_UPSERT_INPUT_GLOB=RemindMe*
# Pinecone index name. Defaults to PINECONE_INDEX_NAME or PINECONE_INDEX. Sample: remindme.
# AGENTICAI_VECTORDB_UPSERT_INDEX=remindme
# Pinecone namespace to upsert into. Sample: __default__.
# AGENTICAI_VECTORDB_UPSERT_NAMESPACE=__default__
# OpenAI embedding model. Sample: text-embedding-3-small.
# AGENTICAI_VECTORDB_UPSERT_EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimensions requested from OpenAI. Sample: 512.
# AGENTICAI_VECTORDB_UPSERT_EMBEDDING_DIMENSIONS=512
# Maximum characters per ingestion chunk. Sample: 1200.
# AGENTICAI_VECTORDB_UPSERT_CHUNK_SIZE=1200
# Overlap characters between ingestion chunks. Sample: 200.
# AGENTICAI_VECTORDB_UPSERT_CHUNK_OVERLAP=200
# Texts per embedding request. Sample: 64.
# AGENTICAI_VECTORDB_UPSERT_EMBEDDING_BATCH_SIZE=64
# Vectors per Pinecone upsert request. Sample: 100.
# AGENTICAI_VECTORDB_UPSERT_UPSERT_BATCH_SIZE=100
# Read and chunk files without embedding or upserting. Sample: false.
# AGENTICAI_VECTORDB_UPSERT_DRY_RUN=false
