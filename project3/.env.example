# Copy these project3 settings into the repository-root .env.
# Existing OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL are reused.
TAVILY_API_KEY=
P3_WORKSPACE=market-research
P3_POSTGRES_DB=market_research
P3_POSTGRES_USER=market_research
P3_POSTGRES_PASSWORD=replace-with-a-random-password
P3_POSTGRES_PORT=5434
P3_DATABASE_URL=postgresql://market_research:replace-with-a-random-password@localhost:5434/market_research
P3_MEMORY_COLLECTION=project3_research
P3_EMBEDDING_DIMS=1536
P3_SEARCH_RESULTS=5
P3_NEWS_DAYS=30
P3_TIMEOUT_SECONDS=60
P3_SOURCE_CHARS=2500
P3_MAX_OUTPUT_TOKENS=3000
P3_DEBUG=false
P3_LOG_FILE=project3/.runtime/research.log
# Optional Unicode TTF font overrides for your organization's supported languages.
P3_PDF_FONT_PATH=
P3_PDF_BOLD_FONT_PATH=

# Streamlit startup script
P3_STREAMLIT_PORT=5555
P3_STREAMLIT_ADDRESS=127.0.0.1

# Appearance defaults (users can override the theme in the sidebar)
P3_DEFAULT_THEME=light
P3_BACKGROUND_ENABLED=true
P3_BACKGROUND_IMAGE=project3/assets/futuristic-it-background.png
