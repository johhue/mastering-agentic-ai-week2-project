#!/usr/bin/env python3
"""Generate 20 random test questions from the RemindMe local corpus."""

from __future__ import annotations

import argparse
import json
import logging
import os
import sys
import random
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path

# Make the shared package available when this file is launched directly.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from utils.common import (
    configure_logging,
    get_required_env,
    load_environment,
    iter_support_files,
    compact_text,
    read_source as read_source_text,
)
from openai import OpenAI


DEFAULT_MODEL = "gpt-4.1-mini"
DEFAULT_OUTPUT_FILE = Path("../20Questions.md")
DEFAULT_QUESTION_COUNT = 20
DEFAULT_CONTEXT_BUDGET = 18000
DEFAULT_RANDOM_SEED = None
TEXT_SUFFIXES = {".csv", ".html", ".json", ".md", ".rst", ".txt", ".yaml", ".yml"}
LOGGER = logging.getLogger(__name__)


class QuestionGenerationError(RuntimeError):
    """Raised when test question generation cannot continue."""


@dataclass(frozen=True)
class SourceDocument:
    path: Path
    text: str


def parse_args() -> argparse.Namespace:
    """Parse CLI options and load environment defaults.

    Called by main before any files are read or OpenAI requests are made.
    """
    load_environment()

    parser = argparse.ArgumentParser(
        description="Generate random RAG test questions from RemindMe* files."
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=DEFAULT_OUTPUT_FILE,
        help="Markdown file to write. Defaults to 20Questions.md.",
    )
    parser.add_argument(
        "--count",
        type=int,
        default=DEFAULT_QUESTION_COUNT,
        help="Number of questions to generate.",
    )
    parser.add_argument(
        "--model",
        default=os.getenv("OPENAI_CHAT_MODEL", DEFAULT_MODEL),
        help="OpenAI chat model to use.",
    )
    parser.add_argument(
        "--context-budget",
        type=int,
        default=DEFAULT_CONTEXT_BUDGET,
        help="Approximate character budget for sampled source context.",
    )
    parser.add_argument(
        "--seed",
        type=int,
        default=DEFAULT_RANDOM_SEED,
        help="Optional random seed for repeatable source sampling.",
    )
    return parser.parse_args()


def read_source(path: Path) -> SourceDocument:
    """Read one source file and return compacted text with its path.

    Called by load_sources for each path from iter_support_files. JSON files are
    pretty-printed first when they contain valid JSON so their structure is
    preserved in the sampled context.
    """
    return SourceDocument(path=path, text=compact_text(read_source_text(path)))


def load_sources() -> list[SourceDocument]:
    """Load all non-empty RemindMe source documents.

    Called by main before source sampling. This function calls iter_support_files
    and read_source, then filters out empty documents.
    """
    sources = []
    for path in iter_support_files(TEXT_SUFFIXES):
        source = read_source(path)
        if source.text:
            sources.append(source)
    return sources


def sample_context(
    sources: Sequence[SourceDocument],
    context_budget: int,
    rng: random.Random,
) -> str:
    """Build a randomized context sample within an approximate character budget.

    Called by main after load_sources. The sampled context is passed to
    generate_questions as the source material for OpenAI.
    """
    if context_budget <= 0:
        raise QuestionGenerationError("--context-budget must be greater than zero.")

    shuffled_sources = list(sources)
    rng.shuffle(shuffled_sources)
    per_source_budget = max(600, context_budget // max(len(shuffled_sources), 1))

    blocks: list[str] = []
    remaining = context_budget
    for source in shuffled_sources:
        if remaining <= 0:
            break

        text = source.text
        excerpt_size = min(len(text), per_source_budget, remaining)
        if len(text) > excerpt_size:
            start = rng.randint(0, max(len(text) - excerpt_size, 0))
            excerpt = text[start : start + excerpt_size].strip()
        else:
            excerpt = text

        block = f"Source: {source.path}\nExcerpt: {excerpt}"
        blocks.append(block)
        remaining -= len(block)

    return "\n\n".join(blocks)


def extract_questions(response_text: str) -> list[str]:
    """Parse OpenAI JSON output into a clean list of question strings.

    Called by generate_questions after receiving the chat completion response.
    Raises QuestionGenerationError when the response is not valid JSON or does
    not contain a questions list.
    """
    try:
        data = json.loads(response_text)
    except json.JSONDecodeError as questions_json_error:
        raise QuestionGenerationError(f"OpenAI did not return valid JSON: {questions_json_error}") from questions_json_error

    questions = data.get("questions")
    if not isinstance(questions, list):
        raise QuestionGenerationError("OpenAI JSON response did not include a questions list.")

    clean_questions = []
    for item in questions:
        if isinstance(item, str):
            question = item.strip()
        elif isinstance(item, dict):
            question = str(item.get("question") or "").strip()
        else:
            continue

        if question:
            clean_questions.append(question)

    return clean_questions


def generate_questions(
    client: OpenAI,
    model: str,
    context: str,
    count: int,
) -> list[str]:
    """Ask OpenAI to generate the requested number of test questions.

    Called by main after sampling source context. This function calls
    extract_questions to validate and normalize the model response.
    """
    if count <= 0:
        raise QuestionGenerationError("--count must be greater than zero.")

    response = client.chat.completions.create(
        model=model,
        temperature=0.9,
        response_format={"type": "json_object"},
        messages=[
            {
                "role": "system",
                "content": (
                    "You generate evaluation questions for a RAG customer support "
                    "system. Return only JSON with a 'questions' array of strings."
                ),
            },
            {
                "role": "user",
                "content": (
                    f"Create exactly {count} varied, realistic questions that a user, "
                    "support agent, manager, or auditor might ask about the RemindMe "
                    "support tickets, FAQs, product manuals, policies, and operational "
                    "data below. Mix easy lookup questions, troubleshooting questions, "
                    "policy questions, and cross-document questions. Do not answer the "
                    "questions.\n\n"
                    f"RemindMe source context:\n{context}"
                ),
            },
        ],
    )

    response_text = response.choices[0].message.content or ""
    questions = extract_questions(response_text)
    if len(questions) != count:
        raise QuestionGenerationError(
            f"Expected {count} questions, but OpenAI returned {len(questions)}."
        )
    return questions


def write_markdown(path: Path, questions: Sequence[str], model: str) -> None:
    """Write generated questions to a Markdown file.

    Called by main after generate_questions returns the final question list.
    """
    lines = [
        "# 20 Test Questions",
        "",
        "Generated from the local `RemindMe*` files for testing the Pinecone/OpenAI RAG application.",
        "",
        f"Model: `{model}`",
        "",
    ]
    for index, question in enumerate(questions, 1):
        lines.append(f"{index}. {question}")
    lines.append("")
    path.write_text("\n".join(lines), encoding="utf-8")


def main() -> int:
    """Run the question-generation CLI and return a process exit code.

    Called by the module entrypoint when this script is executed directly.
    Orchestrates argument parsing, source loading, context sampling, OpenAI
    generation, and Markdown output.
    """
    configure_logging()
    args = parse_args()
    sources = load_sources()
    if not sources:
        raise QuestionGenerationError("No readable files found in RemindMe* directories.")

    rng = random.Random(args.seed)
    context = sample_context(sources, args.context_budget, rng)
    openai_api_key = get_required_env("OPENAI_API_KEY", QuestionGenerationError)
    questions = generate_questions(
        client=OpenAI(api_key=openai_api_key),
        model=args.model,
        context=context,
        count=args.count,
    )
    write_markdown(args.output, questions, args.model)
    LOGGER.info("Wrote %s questions to %s", len(questions), args.output)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except QuestionGenerationError as question_generation_cli_error:
        LOGGER.error("Error: %s", question_generation_cli_error)
        raise SystemExit(1) from question_generation_cli_error
