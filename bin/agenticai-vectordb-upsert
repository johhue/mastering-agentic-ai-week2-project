#!/usr/bin/env python3
"""Read RemindMe files, embed them with OpenAI, and upsert to Pinecone.

Required .env values:
    OPENAI_API_KEY=...
    PINECONE_API_KEY=...
    PINECONE_INDEX_NAME=...

Optional .env values:
    OPENAI_EMBEDDING_MODEL=text-embedding-3-small
    OPENAI_EMBEDDING_DIMENSIONS=512
    PINECONE_NAMESPACE=__default__
"""

from __future__ import annotations

from optparse import Values
import hashlib
import logging
import os
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any

# Make the shared package available when this file is launched directly.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from utils.cli import parse_options, create_parser, configure_cli_logging
from utils.common import (
    batched,
    find_input_dirs,
    iter_text_files,
    read_text,
    split_text,
    stable_vector_id,
)
from openai import OpenAI
from pinecone import Pinecone


DEFAULT_INPUT_GLOB = "RemindMe*"
DEFAULT_EMBEDDING_MODEL = "text-embedding-3-small"
DEFAULT_EMBEDDING_DIMENSIONS = 512
DEFAULT_NAMESPACE = "__default__"
LOGGER = logging.getLogger(__name__)
TEXT_SUFFIXES = {
    ".csv",
    ".html",
    ".json",
    ".log",
    ".md",
    ".py",
    ".rst",
    ".text",
    ".txt",
    ".xml",
    ".yaml",
    ".yml",
}


class UpsertError(RuntimeError):
    """Raised when the upsert cannot continue."""


@dataclass(frozen=True)
class DocumentChunk:
    """A single chunk of text and its source location."""

    source_path: Path
    chunk_index: int
    text: str

    @property
    def vector_id(self) -> str:
        """Return a stable vector ID derived from source path, index, and text.

        Called by build_vectors when constructing Pinecone upsert payloads.
        """
        return stable_vector_id(self.source_path, self.chunk_index, self.text)


def parse_args(argv: list[str] | None = None) -> Values:
    """Parse CLI options and load .env-backed defaults.

    Called by main before directories are scanned or credentials are validated.
    """
    parser = create_parser(
        description="Embed files in RemindMe* directories and upsert them to Pinecone.",
        argv=argv, prog=Path(__file__).name,
    )
    parser.add_option(
        "--input-glob",
        default=DEFAULT_INPUT_GLOB,
        help="Directory glob to scan. Defaults to RemindMe*.",
    )
    parser.add_option(
        "--index",
        default=os.getenv("PINECONE_INDEX_NAME") or os.getenv("PINECONE_INDEX"),
        help="Pinecone index name. Defaults to PINECONE_INDEX_NAME or PINECONE_INDEX.",
    )
    parser.add_option(
        "--namespace",
        default=os.getenv("PINECONE_NAMESPACE", DEFAULT_NAMESPACE),
        help="Pinecone namespace to upsert into.",
    )
    parser.add_option(
        "--embedding-model",
        default=os.getenv("OPENAI_EMBEDDING_MODEL", DEFAULT_EMBEDDING_MODEL),
        help="OpenAI embedding model.",
    )
    parser.add_option(
        "--embedding-dimensions",
        type="positive_int",
        default=os.getenv("OPENAI_EMBEDDING_DIMENSIONS", str(DEFAULT_EMBEDDING_DIMENSIONS)),
        help="Embedding dimensions requested from OpenAI.",
    )
    parser.add_option("--chunk-size", type="positive_int", default=1200)
    parser.add_option("--chunk-overlap", type="int", default=200)
    parser.add_option("--embedding-batch-size", type="positive_int", default=64)
    parser.add_option("--upsert-batch-size", type="positive_int", default=100)
    parser.add_option(
        "--dry-run",
        action="store_true",
        help="Read and chunk files without embedding or upserting.",
    )
    args = parse_options(parser, argv)
    if not 0 <= args.chunk_overlap < args.chunk_size:
        parser.error('--chunk-overlap must be nonnegative and smaller than --chunk-size.')
    return args


def load_chunks(
    input_dirs: Sequence[Path],
    chunk_size: int,
    chunk_overlap: int,
) -> list[DocumentChunk]:
    """Load, split, and label all supported files as DocumentChunk objects.

    Called by main before dry-run handling or embedding. This function calls
    iter_text_files, read_text, and split_text.
    """
    chunks: list[DocumentChunk] = []
    for path in iter_text_files(input_dirs, TEXT_SUFFIXES):
        text = read_text(path)
        if not text:
            continue
        for chunk_index, chunk in enumerate(split_text(text, chunk_size, chunk_overlap)):
            chunks.append(DocumentChunk(path, chunk_index, chunk))
    return chunks


def embed_texts(
    client: OpenAI,
    texts: Sequence[str],
    model: str,
    dimensions: int,
) -> list[list[float]]:
    """Create OpenAI embeddings for a batch of text chunks.

    Called by upsert_chunks for each embedding batch. Raises UpsertError with
    context when the OpenAI embedding request fails.
    """
    try:
        response = client.embeddings.create(
            model=model,
            input=list(texts),
            dimensions=dimensions,
            encoding_format="float",
        )
    except Exception as embedding_request_error:
        raise UpsertError(f"Failed to create OpenAI embeddings: {embedding_request_error}") from embedding_request_error

    return [item.embedding for item in sorted(response.data, key=lambda item: item.index)]


def build_vectors(
    chunks: Sequence[DocumentChunk],
    embeddings: Sequence[Sequence[float]],
) -> list[dict[str, Any]]:
    """Build Pinecone vector dictionaries from chunks and embeddings.

    Called by upsert_chunks after embed_texts returns. The output contains
    vector IDs, embedding values, and metadata used later by query scripts.
    """
    vectors: list[dict[str, Any]] = []
    for chunk, embedding in zip(chunks, embeddings, strict=True):
        vectors.append(
            {
                "id": chunk.vector_id,
                "values": list(embedding),
                "metadata": {
                    "source": str(chunk.source_path),
                    "source_name": chunk.source_path.name,
                    "source_dir": chunk.source_path.parent.name,
                    "chunk_index": chunk.chunk_index,
                    "text": chunk.text,
                    "sha256": hashlib.sha256(chunk.text.encode("utf-8")).hexdigest(),
                },
            }
        )
    return vectors


def validate_environment(args: Values) -> tuple[str, str, str]:
    """Validate required API credentials and target Pinecone index settings.

    Called by main after dry-run handling and before creating OpenAI or Pinecone
    clients.
    """
    openai_api_key = os.getenv("OPENAI_API_KEY")
    pinecone_api_key = os.getenv("PINECONE_API_KEY")

    missing = []
    if not openai_api_key:
        missing.append("OPENAI_API_KEY")
    if not pinecone_api_key:
        missing.append("PINECONE_API_KEY")
    if not args.index:
        missing.append("PINECONE_INDEX_NAME")
    if missing:
        raise UpsertError(f"Missing required .env values: {', '.join(missing)}")

    return openai_api_key, pinecone_api_key, args.index


def upsert_chunks(
    chunks: Sequence[DocumentChunk],
    openai_client: OpenAI,
    pinecone_client: Pinecone,
    index_name: str,
    namespace: str,
    embedding_model: str,
    embedding_dimensions: int,
    embedding_batch_size: int,
    upsert_batch_size: int,
) -> int:
    """Embed document chunks and upsert them into Pinecone.

    Called by main after environment validation. This function calls embed_texts,
    build_vectors, and the shared batched helper to control OpenAI and Pinecone
    request sizes.
    """
    index = pinecone_client.Index(index_name)
    uploaded = 0

    for chunk_batch in batched(chunks, embedding_batch_size):
        embeddings = embed_texts(
            client=openai_client,
            texts=[chunk.text for chunk in chunk_batch],
            model=embedding_model,
            dimensions=embedding_dimensions,
        )
        vectors = build_vectors(chunk_batch, embeddings)

        for vector_batch in batched(vectors, upsert_batch_size):
            index.upsert(vectors=list(vector_batch), namespace=namespace)
            uploaded += len(vector_batch)
            LOGGER.info("Upserted %s/%s chunks", uploaded, len(chunks))

    return uploaded


def main() -> int:
    """Run the file-to-Pinecone upsert CLI and return a process exit code.

    Called by the module entrypoint when this script is executed directly.
    Coordinates logging, argument parsing, corpus loading, dry-run handling,
    credential validation, embedding, and Pinecone upsert.
    """
    args = parse_args()
    configure_cli_logging(args)

    input_dirs = find_input_dirs(args.input_glob)
    if not input_dirs:
        raise UpsertError(f"No RemindMe directories found for glob: {args.input_glob}")

    chunks = load_chunks(input_dirs, args.chunk_size, args.chunk_overlap)
    if not chunks:
        LOGGER.info("No supported text files found.")
        return 0

    LOGGER.info(
        "Loaded %s chunks from %s",
        len(chunks),
        ", ".join(str(path) for path in input_dirs),
    )
    if args.dry_run:
        return 0

    openai_api_key, pinecone_api_key, index_name = validate_environment(args)
    uploaded = upsert_chunks(
        chunks=chunks,
        openai_client=OpenAI(api_key=openai_api_key),
        pinecone_client=Pinecone(api_key=pinecone_api_key),
        index_name=index_name,
        namespace=args.namespace,
        embedding_model=args.embedding_model,
        embedding_dimensions=args.embedding_dimensions,
        embedding_batch_size=args.embedding_batch_size,
        upsert_batch_size=args.upsert_batch_size,
    )

    LOGGER.info(
        "Done. Upserted %s chunks to index '%s' in namespace '%s'.",
        uploaded,
        index_name,
        args.namespace,
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (UpsertError, ValueError) as upsert_cli_error:
        LOGGER.error("Error: %s", upsert_cli_error)
        raise SystemExit(1) from upsert_cli_error
