#!/usr/bin/env python3
"""Ask an OpenAI model one question using the repository's .env settings."""

from __future__ import annotations

import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from openai import APIConnectionError, APIStatusError, OpenAI
from utils import common
from optparse import OptionParser, OptionGroup, Values, OptionValueError
from dotenv import load_dotenv

# Load variables from the .env file into the environment
load_dotenv()

def parse_args(argv: list[str] | None = None) -> Values:
    try:

        parser = OptionParser()

        # Options
        main_group = OptionGroup(parser, os.path.basename(__file__) + " options", "Also run the tool-calling loop after MCP discovery")
        main_group.add_option('-z', '--question', dest="question", type="string", action="store", help="Question", default="What is the capitol of California.")

        parser.add_option_group(main_group)

        # Add the Common environment/app/component/node options
        app_arg_group = common.get_app_arg_group(parser)
        parser.add_option_group(app_arg_group)

        # Add the standard args
        common_arg_group = common.get_common_arg_group(parser)
        parser.add_option_group(common_arg_group)

        options, remainder = parser.parse_args()

        return options

    except Exception as parse_args_err:
        raise RuntimeError(common.generic_error_message(error_code="PUPPET-100", err=parse_args_err))



def main() -> int:
    """Read a question, request an answer, and report failures without secrets."""


    try:

        # Print explicit diagnostics below without exposing SDK authorization headers.
        import logging
        for logger_name in ("openai", "httpx", "httpcore"):
            logging.getLogger(logger_name).setLevel(logging.WARNING)
        log.info("OpenAI chat started.")
        question = (opts.question if opts.question is not None else input("Question: ")).strip()
        if not question:
            raise ValueError("Question must not be empty.")
        api_key = common.get_required_env("OPENAI_API_KEY","X")
        model = common.get_required_env("OPENAI_MODEL", "X").strip()
        if not model:
            raise ValueError("OPENAI_MODEL must not be empty.")
        log.debug("Question accepted (%d characters).", len(question))
        log.info("Sending question to model %s.", model)
        with OpenAI(
            api_key=api_key,
            base_url= common.get_required_env("OPENAI_BASE_URL", "X"),
        ) as client:
            request = dict(
                model=model,
                input=question,
                instructions=(
                    "Respond in two clearly labeled sections: 'Answer' and "
                    "'Brief explanation'. In Brief explanation, give a concise "
                    "summary of the approach, key assumptions, and any uncertainty. "
                    "Do not provide private internal reasoning or claim the "
                    "explanation is a transcript of your thoughts."
                ),
                store=False,
            )
            log.info(f"Base URL: {client.base_url}")
            log.info("Request JSON:\n" + json.dumps(request, indent=2, ensure_ascii=False))
            response = client.responses.create(**request)
            log.info("Response JSON:\n" + response.model_dump_json(indent=2))
        answer = response.output_text.strip()
        if not answer:
            raise RuntimeError("The model returned no text answer.")
        log.info(answer)
        log.info("Answer received; chat completed.")
        return 0
    except (KeyboardInterrupt, EOFError):
        log.info("Chat cancelled.")
        return 130
    except APIConnectionError:
        log.error("Could not connect to OpenAI. Check connectivity and OPENAI_BASE_URL.")
    except APIStatusError as api_status_error:
        log.error("OpenAI request failed (HTTP %s) error=%s. Check credentials, model access and quota.", api_status_error.status_code, api_status_error)
    except (ValueError, RuntimeError, OSError) as chat_error:
        log.error("Chat failed: %s", chat_error)
    except Exception as unexpected_chat_error:
        log.error("Unexpected chat failure (%s) %s.", type(unexpected_chat_error).__name__, unexpected_chat_error)
    return 1


if __name__ == '__main__':

    try:

        import os
        import platform

        opts = parse_args()

        hostname = platform.node()
        script_label = os.path.basename(__file__).replace('.py', '')

        app_list = []

        log = common.initialize_logging(label=script_label)

        # Load config dict
        default_config_files = common.get_default_config_files(os.path.abspath(__file__), __file__)
        config_dict = common.load_config_file(opts.config_file, default_config_files)
        if config_dict is None:
            log.error(
                "No config file could be loaded. Give -F <config file> or use one of default config files:\n\t" + '\n\t'.join(
                    default_config_files))
            sys.exit(1)

        log.info(f"Loaded config file: {config_dict['loaded_config_file']}")
        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        # Print the config if in debug:
        if opts.verbose:
            common.print_config_dict(config_dict)

        # main
        main()

    except Exception as outer_main_err:
        raise RuntimeError(common.generic_error_message(error_code='AIML-100', err=outer_main_err))


