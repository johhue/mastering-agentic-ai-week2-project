#!/usr/bin/env python3
"""Have a terminal conversation with OpenAI, with brief answer explanations."""

from __future__ import annotations

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from openai import APIConnectionError, APIStatusError, OpenAI
from utils.cli import parse_options, create_parser
from utils import common
from optparse import OptionParser, OptionGroup, Values, OptionValueError
from dotenv import load_dotenv

# Load variables from the .env file into the environment
load_dotenv()

INSTRUCTIONS = (
    "Respond in sections labeled 'Answer' and 'Brief explanation'. Give a "
    "concise explanation of the approach, key assumptions, and uncertainty. "
    "Do not disclose private internal reasoning or present the explanation "
    "as a transcript of your thoughts. Use the earlier conversation as context."
)


def converse(client: OpenAI, model: str) -> None:
    """Run the input loop, retaining only successful turns in memory."""
    history: list[dict[str, str]] = []
    log.info("Commands: /exit to quit, /clear to start a new conversation.")
    log.info("Each answer includes a brief explanation, not private internal reasoning.")
    while True:
        try:
            question = input("\nYou: ").strip()
        except EOFError:
            log.info("Conversation ended at end of input.")
            return
        if question.lower() in {"/exit", "/quit", "exit", "quit"}:
            log.info("Conversation ended by user.")
            return
        if question.lower() == "/clear":
            history.clear()
            log.info("Conversation history cleared.")
            log.info("Conversation cleared.")
            continue
        if not question:
            log.debug("Ignored empty input.")
            continue
        pending = [*history, {"role": "user", "content": question}]
        log.info(pending)
        try:
            log.info("Sending conversation turn %d.", len(history) // 2 + 1)
            response = client.responses.create(
                model=model, input=pending, instructions=INSTRUCTIONS, store=False
            )
            answer = response.output_text.strip()
            if not answer:
                log.warning("Model returned no text; history retained without this turn.")
                log.info("No text answer received. Please try again.")
                continue
            history = [*pending, {"role": "assistant", "content": answer}]
            log.info(f"\nOpenAI:\n{answer}")
            log.info("Conversation answer received.")
            log.debug("History contains %d messages.", len(history))
        except APIConnectionError:
            log.error("Connection failed. Check connectivity and OPENAI_BASE_URL; retry your message.")
        except APIStatusError as turn_api_error:
            log.error("OpenAI returned HTTP %s. Check credentials, "
                      "model access or quota; /clear can reset long history.", turn_api_error.status_code)


def parse_args(argv: list[str] | None = None) -> Values:
    """Parse command options before initializing logging or external clients."""
    try:

        parser = OptionParser()

        # Options
        main_group = OptionGroup(parser, os.path.basename(__file__) + " options", "Also run the tool-calling loop after MCP discovery")
        main_group.add_option('-w', '--with_agent', dest="with_agent", action="store_true", help="Sample Question", default="Who is the contact in the CAISO Cafe.")
        main_group.add_option('-s', '--sample_question', dest="sample_question", type="string", action="store", help="Puppet Module")
        main_group.add_option('-c', '--conversation', dest="conversation", action="store_true", help="Conduct a conversation or not.")
        parser.add_option_group(main_group)

        # Add the Common environment/app/component/node options
        app_arg_group = common.get_app_arg_group(parser)
        parser.add_option_group(app_arg_group)

        # Add the standard args
        common_arg_group = common.get_common_arg_group(parser)
        parser.add_option_group(common_arg_group)

        options, remainder = parser.parse_args()

        return options

    except Exception as parse_args_err:
        raise RuntimeError(common.generic_error_message(error_code="PUPPET-100", err=parse_args_err))

    parser = create_parser(description=__doc__, argv=argv, prog=Path(__file__).name)
    return parse_options(parser, argv)


def main() -> int:
    """Load .env configuration, initialize logging and handle session failures."""

    try:
        import logging
        for logger_name in ("openai", "httpx", "httpcore"):
            logging.getLogger(logger_name).setLevel(logging.WARNING)
        api_key = common.get_required_env("OPENAI_API_KEY", "X")
        model = common.get_required_env("OPENAI_MODEL", "X").strip()
        if not model:
            raise ValueError("OPENAI_MODEL must not be empty.")
        log.info("Starting OpenAI conversation with model %s.", model)
        with OpenAI(api_key=api_key, base_url= common.get_required_env("OPENAI_BASE_URL", "X")) as client:
            converse(client, model)
        return 0
    except KeyboardInterrupt:
        log.info("Conversation interrupted.")
        return 130
    except (ValueError, RuntimeError, OSError) as conversation_error:
        log.error("Conversation failed: %s", conversation_error)
    except Exception as unexpected_conversation_error:
        log.error("Unexpected conversation failure (%s).", type(unexpected_conversation_error).__name__)
    return 1


if __name__ == '__main__':

    try:

        import os
        import platform

        opts = parse_args()

        hostname = platform.node()
        script_label = os.path.basename(__file__).replace('.py', '')

        app_list = []

        log = common.initialize_logging(label=script_label)

        # Load config dict
        default_config_files = common.get_default_config_files(os.path.abspath(__file__), __file__)
        config_dict = common.load_config_file(opts.config_file, default_config_files)
        if config_dict is None:
            log.error(
                "No config file could be loaded. Give -F <config file> or use one of default config files:\n\t" + '\n\t'.join(
                    default_config_files))
            sys.exit(1)

        log.info(f"Loaded config file: {config_dict['loaded_config_file']}")
        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        # Print the config if in debug:
        if opts.verbose:
            common.print_config_dict(config_dict)

        # main
        main()

    except Exception as outer_main_err:
        raise RuntimeError(common.generic_error_message(error_code='AIML-100', err=outer_main_err))

