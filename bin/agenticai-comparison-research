#!/usr/bin/env python3
"""Run live comparison research or a fictional offline demo from the terminal."""
from __future__ import annotations

from contextlib import ExitStack
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from utils.cli import parse_options, create_parser
from utils.config import ResearchError, Settings
from utils import common
from optparse import OptionParser, OptionGroup, Values, OptionValueError
from dotenv import load_dotenv

# Load variables from the .env file into the environment
load_dotenv()

def parse_args(argv: list[str] | None = None) -> Values:

    try:

        parser = OptionParser()

        # Options
        main_group = OptionGroup(parser, os.path.basename(__file__) + " options", "Also run the tool-calling loop after MCP discovery")
        main_group.add_option('-X', '--company', dest="company", action="store", type="str", help="Company", default="Company by which to do research.")
        main_group.add_option('-s', '--sample_question', dest="sample_question", type="string", action="store", help="Puppet Module")
        main_group.add_option('-c', '--conversation', dest="conversation", action="store_true", help="Conduct a conversation or not.")
        main_group.add_option('--demo', action='store_true', help='Use fictional offline services without API calls.')
        main_group.add_option('--format', type='choice', choices=('json', 'markdown'), default='json',
                          help='Briefing output format.')
        main_group.add_option('--output', type="str", help='Create a new output file instead of writing to stdout.')
        main_group.add_option('--memory-method', type='str',
                          default = common.get_required_env('MEMORY_METHOD', 'FILESYSTEM'),
                          help='Live memory backend (MEMORY_METHOD).')
        parser.add_option_group(main_group)

        # Add the Common environment/app/component/node options
        app_arg_group = common.get_app_arg_group(parser)
        parser.add_option_group(app_arg_group)

        # Add the standard args
        common_arg_group = common.get_common_arg_group(parser)
        parser.add_option_group(common_arg_group)

        options, remainder = parser.parse_args()

        return options


    except Exception as parse_args_err:
        raise RuntimeError(common.generic_error_message(error_code="PUPPET-100", err=parse_args_err))


def main() -> int:
    """Execute the graph, export its briefing and close live clients on all paths."""

    clients = []
    try:

        from comparison_app.pipeline import ResearchPipeline
        from comparison_app.demo import DemoAnalyst, DemoMemory, DemoSearch

        with ExitStack() as files:
            output = files.enter_context(opts.output.expanduser().open('x', encoding='utf-8')) if opts.output else sys.stdout
            if opts.demo:
                search, analyst, memory = DemoSearch(), DemoAnalyst(), DemoMemory()
                news_days = 30
                log.warning('SYNTHETIC DEMO: output describes fictional companies.')
            else:
                from comparison_app.analyst_service import Analyst
                from comparison_app.search_service import TavilySearchService
                if opts.memory_method == 'MEM0':
                    from comparison_app.memory_mem0 import SharedMemoryMem0 as Memory
                else:
                    from comparison_app.memory_filesystem import SharedMemoryFileSystem as Memory

                settings = Settings.from_env()
                memory = Memory(settings)
                clients.append(memory)
                analyst = Analyst(settings)
                clients.append(analyst)
                search, news_days = TavilySearchService(settings=settings, log=log), settings.news_days
            log.info('Starting comparison research (demo=%s).', opts.demo)
            pipeline = ResearchPipeline(search=search, analyst=analyst, memory=memory, news_days=news_days, log=log)
            state = pipeline.graph.invoke({'company': opts.company, 'warnings': []}, config={'max_concurrency': 2})
            briefing = state['briefing'].model_copy(update={'demo': opts.demo})
            if opts.format == 'markdown':
                from comparison_app.export import markdown_briefing
                content = markdown_briefing(briefing)
            else:
                content = briefing.model_dump_json(indent=2)
            output.write(content + '\n')
            output.flush()
            log.info('Comparison research complete. Run ID: %s.', briefing.run_id)
        return 0
    except KeyboardInterrupt:
        log.info('Comparison research interrupted.')
        return 130
    except ResearchError as research_error:
        log.error('Comparison research failed: %s', research_error)
        return 1
    except Exception as cli_error:
        log.error('Comparison research failed (%s) %s. Check configuration, service access and output path.', type(cli_error).__name__, cli_error)
        return 1
    finally:
        for client in reversed(clients):
            try:
                client.close()
            except Exception as cleanup_error:
                log.warning('Research client cleanup failed (%s). %s', type(cleanup_error).__name__, cleanup_error)


if __name__ == '__main__':

    try:

        import os
        import platform

        opts = parse_args()

        hostname = platform.node()
        script_label = os.path.basename(__file__).replace('.py', '')

        app_list = []

        log = common.initialize_logging(label=script_label)

        # Load Env Variables

        # Load config dict
        default_config_files = common.get_default_config_files(os.path.abspath(__file__), __file__)
        config_dict = common.load_config_file(opts.config_file, default_config_files)
        if config_dict is None:
            log.error(
                "No config file could be loaded. Give -F <config file> or use one of default config files:\n\t" + '\n\t'.join(
                    default_config_files))
            sys.exit(1)

        log.info(f"Loaded config file: {config_dict['loaded_config_file']}")
        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        # Print the config if in debug:
        if opts.verbose:
            common.print_config_dict(config_dict)

        # main
        main()

    except Exception as outer_main_err:
        raise RuntimeError(common.generic_error_message(error_code='AIML-100', err=outer_main_err))