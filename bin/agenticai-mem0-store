#!/usr/bin/env python3
"""Store a JSON artifact in hosted mem0.ai using the comparison app's memory API."""
from __future__ import annotations

import argparse
import json
import logging
from pathlib import Path
import sys
from types import SimpleNamespace
from uuid import uuid4

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from utils.config import integer, required
from utils.common import configure_logging

from comparison_app.memory_mem0 import SharedMemory

log = configure_logging()


def main() -> int:
    """Validate JSON input, store an exact artifact and print its run and memory IDs."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file', help='UTF-8 JSON object file, or - for stdin')
    parser.add_argument('--company', required=True)
    parser.add_argument('--kind', default='manual')
    parser.add_argument('--run-id', default=None)
    args = parser.parse_args()
    memory = None
    try:
        configure_logging()
        if not args.company.strip() or not args.kind.strip() or args.run_id == '':
            raise ValueError('Company, kind and run ID must be nonempty.')
        text = sys.stdin.read() if args.file == '-' else Path(args.file).read_text(encoding='utf-8')
        payload = json.loads(text)
        if not isinstance(payload, dict):
            raise ValueError('Input must be a JSON object.')
        import os
        settings = SimpleNamespace(mem0_key=required('MEM0_API_KEY'),
            workspace=os.getenv('P3_WORKSPACE', 'market-research'),
            timeout=integer('P3_TIMEOUT_SECONDS', 60, maximum=300))
        run_id = args.run_id or uuid4().hex
        memory = SharedMemory(settings)
        ids = memory.write(args.company.strip(), run_id, args.kind.strip(), payload)
        print(json.dumps({'run_id': run_id, 'memory_ids': ids}))
        log.info('Stored JSON artifact in hosted mem0.ai.')
        return 0
    except Exception as store_error:
        log.error('Memory storage failed (%s). Check JSON input, .env and service access.',
                  type(store_error).__name__)
        return 1
    finally:
        if memory is not None:
            try:
                memory.close()
            except Exception as cleanup_error:
                log.warning('Memory client cleanup failed (%s).', type(cleanup_error).__name__)


if __name__ == '__main__':
    sys.exit(main())
