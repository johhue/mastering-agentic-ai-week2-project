#!/usr/bin/env python3
"""List files that have been upserted to a Pinecone index.

The script loads Pinecone credentials from .env, lists vector IDs in the target
namespace, fetches their metadata, and summarizes distinct source files.
"""

from __future__ import annotations

import sys
from collections.abc import Iterable, Iterator, Sequence
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any
from optparse import OptionParser, OptionGroup, Values, OptionValueError
from dotenv import load_dotenv

# Load variables from the .env file into the environment
load_dotenv()

# Direct execution puts bin/, rather than the project root, on sys.path.
PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from utils.cli import parse_options, create_parser
from utils import common

from pinecone import Pinecone, PineconeException

DEFAULT_NAMESPACE = "__default__"
DEFAULT_BATCH_SIZE = 100


class QueryPineconeError(RuntimeError):
    """Raised when Pinecone inspection cannot continue."""


@dataclass
class SourceSummary:
    """Collect source metadata and chunk identifiers for inspection output."""

    source: str
    source_name: str = ""
    source_dir: str = ""
    vector_ids: list[str] = field(default_factory=list)
    chunk_indexes: set[int] = field(default_factory=set)


def create_pinecone_index(api_key: str, index_name: str) -> Any:
    """Create a Pinecone index handle and normalize connection failures.

    Called by main after validating the Pinecone API key and index name.
    """
    try:
        pinecone_client = Pinecone(api_key=api_key)
        return pinecone_client.Index(index_name)
    except PineconeException as index_connection_error:
        raise QueryPineconeError(
            f"Could not connect to Pinecone index '{index_name}': {index_connection_error}"
        ) from index_connection_error
    except Exception as index_creation_error:
        raise QueryPineconeError(
            f"Unexpected error while creating Pinecone index '{index_name}': {index_creation_error}"
        ) from index_creation_error


def parse_args(argv: list[str] | None = None) -> Values:
    """Load .env values and parse command-line arguments.

    Called by main to determine the target index, namespace, and output options.
    """

    try:

        parser = OptionParser()

        # Options
        main_group = OptionGroup(parser, os.path.basename(__file__) + " options", "Also run the tool-calling loop after MCP discovery")
        main_group.add_option('-w', '--with_agent', dest="with_agent", action="store_true", help="Sample Question", default="Who is the contact in the CAISO Cafe.")
        main_group.add_option('-s', '--sample_question', dest="sample_question", type="string", action="store", help="Puppet Module")
        main_group.add_option('-c', '--conversation', dest="conversation", action="store_true", help="Conduct a conversation or not.")

        main_group.add_option(
            "--index",
            default=common.get_required_env("PINECONE_INDEX_NAME", "X"),
            help="Pinecone index name. Defaults to PINECONE_INDEX_NAME or PINECONE_INDEX.",
        )
        main_group.add_option(
            "--namespace",
            default=common.get_required_env("PINECONE_NAMESPACE", DEFAULT_NAMESPACE),
            help="Pinecone namespace to inspect.",
        )
        main_group.add_option(
            "--all-namespaces",
            action="store_true",
            help="Inspect every namespace reported by Pinecone index stats.",
        )
        main_group.add_option(
            "--batch-size",
            type="int",
            default=DEFAULT_BATCH_SIZE,
            help="Number of vector IDs to fetch at a time.",
        )
        main_group.add_option(
            "--show-chunks",
            action="store_true",
            help="Print vector IDs and chunk indexes under each source file.",
        )

        parser.add_option_group(main_group)

        # Add the Common environment/app/component/node options
        app_arg_group = common.get_app_arg_group(parser)
        parser.add_option_group(app_arg_group)

        # Add the standard args
        common_arg_group = common.get_common_arg_group(parser)
        parser.add_option_group(common_arg_group)

        options, remainder = parser.parse_args()

        return options

    except Exception as parse_args_err:
        raise RuntimeError(common.generic_error_message(error_code="PUPPET-100", err=parse_args_err))


def flatten_list_response(response: Any) -> Iterator[str]:
    """Flatten Pinecone list response pages into vector ID strings.

    Called by list_vector_ids and recursively by itself for nested response data.
    """
    if response is None:
        return

    if isinstance(response, str):
        yield response
        return

    if isinstance(response, dict):
        vectors = response.get("vectors")
        if vectors is not None:
            yield from flatten_list_response(vectors)
            return
        vector_ids = response.get("ids")
        if vector_ids is not None:
            yield from flatten_list_response(vector_ids)
            return

    if hasattr(response, "vectors"):
        yield from flatten_list_response(getattr(response, "vectors"))
        return
    if hasattr(response, "ids"):
        yield from flatten_list_response(getattr(response, "ids"))
        return

    if isinstance(response, Iterable):
        for item in response:
            if isinstance(item, str):
                yield item
            else:
                yield from flatten_list_response(item)


def list_vector_ids(index: Any, namespace: str) -> list[str]:
    """List unique vector IDs in a Pinecone namespace.

    Called by summarize_sources before fetching metadata for each vector ID.
    """
    ids: list[str] = []

    try:
        for page in index.list(namespace=namespace):
            ids.extend(flatten_list_response(page))
    except PineconeException as vector_listing_error:
        raise QueryPineconeError(
            f"Could not list vectors in namespace '{namespace}': {vector_listing_error}"
        ) from vector_listing_error
    except Exception as unexpected_listing_error:
        raise QueryPineconeError(
            f"Unexpected error while listing vectors in namespace '{namespace}': {unexpected_listing_error}"
        ) from unexpected_listing_error

    return sorted(set(ids))


def fetch_metadata(index: Any, ids: Sequence[str], namespace: str) -> dict[str, dict[str, Any]]:
    """Fetch metadata for vector IDs from a Pinecone namespace.

    Called by summarize_sources for each batch of vector IDs.
    """
    try:
        response = index.fetch(ids=list(ids), namespace=namespace)
    except PineconeException as metadata_fetch_error:
        raise QueryPineconeError(
            f"Could not fetch metadata for {len(ids)} vectors in namespace '{namespace}': {metadata_fetch_error}"
        ) from metadata_fetch_error
    except Exception as unexpected_fetch_error:
        raise QueryPineconeError(
            f"Unexpected error while fetching metadata in namespace '{namespace}': {unexpected_fetch_error}"
        ) from unexpected_fetch_error

    vectors = common.get_field(response, "vectors", {}) or {}

    metadata_by_id: dict[str, dict[str, Any]] = {}
    for vector_id, vector in vectors.items():
        metadata = common.get_field(vector, "metadata", {}) or {}
        metadata_by_id[str(vector_id)] = dict(metadata)
    return metadata_by_id


def summarize_sources(
    index: Any,
    namespace: str,
    batch_size: int,
) -> tuple[list[SourceSummary], int]:
    """Build per-source summaries from vectors stored in a namespace.

    Called by main once for each namespace selected for inspection.
    """
    vector_ids = list_vector_ids(index, namespace)
    summaries: dict[str, SourceSummary] = {}

    for id_batch in common.batched(vector_ids, batch_size):
        metadata_by_id = fetch_metadata(index, id_batch, namespace)
        for vector_id in id_batch:
            metadata = metadata_by_id.get(vector_id, {})
            source = str(metadata.get("source") or "(missing source metadata)")
            summary = summaries.setdefault(source, SourceSummary(source=source))
            summary.vector_ids.append(vector_id)

            if metadata.get("source_name"):
                summary.source_name = str(metadata["source_name"])
            if metadata.get("source_dir"):
                summary.source_dir = str(metadata["source_dir"])
            if metadata.get("chunk_index") is not None:
                try:
                    summary.chunk_indexes.add(int(metadata["chunk_index"]))
                except (TypeError, ValueError):
                    pass

    return sorted(summaries.values(), key=lambda item: item.source), len(vector_ids)


def list_namespaces(index: Any) -> list[str]:
    """Return namespace names reported by Pinecone index stats.

    Called by main when the --all-namespaces option is enabled.
    """
    try:
        stats = index.describe_index_stats()
    except PineconeException as namespace_listing_error:
        raise QueryPineconeError(f"Could not list Pinecone namespaces: {namespace_listing_error}") from namespace_listing_error
    except Exception as unexpected_namespace_error:
        raise QueryPineconeError(
            f"Unexpected error while listing Pinecone namespaces: {unexpected_namespace_error}"
        ) from unexpected_namespace_error

    namespaces = common.get_field(stats, "namespaces", {}) or {}
    if isinstance(namespaces, dict):
        return sorted(str(name) for name in namespaces.keys())
    return []


def print_summary(
    namespace: str,
    summaries: Sequence[SourceSummary],
    vector_count: int,
    show_chunks: bool,
) -> None:
    """Log a human-readable summary for one namespace.

    Called by main after summarize_sources returns source and vector counts.
    """
    log.info("\nNamespace: %s", namespace)
    log.info("Vectors: %s", vector_count)
    log.info("Files: %s", len(summaries))

    if not summaries:
        log.info("No vectors found.")
        return

    for index, summary in enumerate(summaries, 1):
        chunk_count = len(summary.vector_ids)
        chunk_label = "chunk" if chunk_count == 1 else "chunks"
        log.info("%2d. %s (%s %s)", index, summary.source, chunk_count, chunk_label)

        if show_chunks:
            chunk_indexes = sorted(summary.chunk_indexes)
            if chunk_indexes:
                log.info("    chunk indexes: %s", chunk_indexes)
            for vector_id in summary.vector_ids:
                log.info("    vector: %s", vector_id)


def main() -> int:
    """Run the query CLI and return the process exit code.

    Called by the module entrypoint when this script is executed directly.
    """

    pinecone_api_key = common.get_required_env("PINECONE_API_KEY", "X")
    if not opts.index:
        raise QueryPineconeError("Missing PINECONE_INDEX_NAME. Add it to .env.")

    index = create_pinecone_index(pinecone_api_key, opts.index)

    namespaces = list_namespaces(index) if opts.all_namespaces else [opts.namespace]
    if not namespaces:
        log.info("No namespaces found.")
        return 0

    total_vectors = 0
    total_files = 0
    log.info("Index: %s", opts.index)
    for namespace in namespaces:
        summaries, vector_count = summarize_sources(index, namespace, opts.batch_size)
        total_vectors += vector_count
        total_files += len(summaries)
        print_summary(namespace, summaries, vector_count, opts.show_chunks)

    log.info("\nTotal vectors: %s", total_vectors)
    log.info("Total file entries: %s", total_files)
    return 0


if __name__ == '__main__':

    try:

        import os
        import platform

        opts = parse_args()

        hostname = platform.node()
        script_label = os.path.basename(__file__).replace('.py', '')

        app_list = []

        log = common.initialize_logging(label=script_label)

        # Load config dict
        default_config_files = common.get_default_config_files(os.path.abspath(__file__), __file__)
        config_dict = common.load_config_file(opts.config_file, default_config_files)
        if config_dict is None:
            log.error(
                "No config file could be loaded. Give -F <config file> or use one of default config files:\n\t" + '\n\t'.join(
                    default_config_files))
            sys.exit(1)

        log.info(f"Loaded config file: {config_dict['loaded_config_file']}")
        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        if opts.verbose:
            import logging

            log.setLevel(logging.DEBUG)

        # Print the config if in debug:
        if opts.verbose:
            common.print_config_dict(config_dict)

        # main
        main()

    except Exception as outer_main_err:
        raise RuntimeError(common.generic_error_message(error_code='AIML-100', err=outer_main_err))