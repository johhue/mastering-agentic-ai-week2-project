# Copy these comparison_app settings into the repository-root .env.
# Existing OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL are reused.
# All bin commands use OptionParser and accept --config PATH (.env format).
# Precedence: environment variables, then config file, then CLI overrides last.
# Any option also supports AGENTICAI_<COMMAND>_<OPTION>, for example:
# AGENTICAI_COMPARISON_RESEARCH_COMPANY=Toyota
# AGENTICAI_COMPARISON_RESEARCH_DEMO=true
# AGENTICAI_COMPARISON_APP_PORT=5555
TAVILY_API_KEY=
MEM0_API_KEY=
MEMORY_METHOD=MEM0
P3_WORKSPACE=market-research
P3_SEARCH_RESULTS=5
P3_NEWS_DAYS=30
P3_TIMEOUT_SECONDS=60
P3_SOURCE_CHARS=2500
P3_MAX_OUTPUT_TOKENS=3000
P3_DEBUG=false
LOG_LEVEL=INFO
LOGGER_FILE=comparison_app/.runtime/research.log
# Optional Unicode TTF font overrides for your organization's supported languages.
P3_PDF_FONT_PATH=
P3_PDF_BOLD_FONT_PATH=

# Streamlit startup script
P3_STREAMLIT_PORT=5555
P3_STREAMLIT_ADDRESS=127.0.0.1
STREAMLIT_SUPPORT_APP_PORT=8501
STREAMLIT_SUPPORT_APP_ADDRESS=127.0.0.1

# Appearance defaults (users can override the theme in the sidebar)
P3_DEFAULT_THEME=light
P3_BACKGROUND_ENABLED=true
P3_BACKGROUND_IMAGE=comparison_app/assets/futuristic-it-background.png
